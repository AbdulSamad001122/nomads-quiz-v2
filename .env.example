# Environment variables for the RPV quiz.
# Copy this file to .env.local and fill in the real values. .env.local is
# gitignored — never commit real keys. On Vercel, set the same names under
# Project → Settings → Environment Variables.

# ——— Kit (server-side only) ———
# Read by api/kit-subscribe.js (and the dev API bridge in vite.config.js).
# No VITE_ prefix, so these never reach the browser bundle.
KIT_API_KEY=your-kit-api-key
KIT_API_SECRET=your-kit-api-secret

# Optional: subscribe through this Kit form. Leave empty to subscribe
# through the tag below instead.
KIT_FORM_ID=

# Optional: entry tag used when KIT_FORM_ID is empty (code default: crpv-quiz).
KIT_TAG_NAME=crpv-quiz

# ——— Browser flags (VITE_ = bundled into the client — no secrets here) ———
# true = `npm run dev` pushes quiz takers to Kit for real. Use @example.com
# test emails only. Production always pushes.
VITE_KIT_DEV=false

# true = send GA4 events from `npm run dev` too. Production always sends.
VITE_GA_DEV=false

# Optional overrides — the public GA4 and Clarity IDs are already in
# src/analytics/ga.js and src/analytics/clarity.js.
VITE_GA_ID=
VITE_CLARITY_ID=
