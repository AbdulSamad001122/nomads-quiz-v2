{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/diagnostic-start-now", "destination": "/index.html" },
    { "source": "/diagnostic-results", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/scoresheet.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Nomads Workshop Scoresheet.pdf\"" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
